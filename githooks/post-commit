#!/bin/sh
# ClipMemory post-commit: main 分支提交后自动触发独立代码审核（后台, 不阻塞 commit）
#
# 串联两段:
#   ① Qoder AI tracker —— 保留（2026-09-21 由 Qoder 应用直接装入 .git/hooks/post-commit,
#      此处原样保留, 使 Qoder 的 commit 追踪不丢失）
#   ② opencode 独立审核 —— 后台触发 githooks/orca-auto-review.sh, 不阻塞 git commit 返回
#
# 仅 main 分支触发自动审核, 避免开发中小提交频繁审核; 开发分支提交前手动跑:
#   bash githooks/orca-auto-review.sh
#
# 本文件是 tracked 源（githooks/post-commit）, 经 githooks/install.sh 复制到
# .git/hooks/post-commit 后生效。若 Qoder 应用之后重装了自己的 post-commit,
# 重新跑一次 githooks/install.sh 即可恢复本串联版本。
set -o pipefail

# ① Qoder AI tracker（保留）
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -W 2>/dev/null || pwd)"
ELECTRON_RUN_AS_NODE=1 "/Applications/Qoder.app/Contents/MacOS/Qoder" "/Applications/Qoder.app/Contents/Resources/app.asar.unpacked/node_modules/@qoder-ai/qoder-agent-sdk/dist/_worker/qoder-worker-runtime.obf.mjs" commit --hook --workspace "$repo_root" 2>/dev/null || true

# ② opencode 独立审核（后台触发, 仅 main 分支）
BR=$(git branch --show-current 2>/dev/null)
[ "$BR" = "main" ] || exit 0

ROOT="$(git rev-parse --show-toplevel)"
REVIEWER="$ROOT/githooks/orca-auto-review.sh"
[ -x "$REVIEWER" ] || exit 0

# 后台跑, 不阻塞 git commit 返回。
# 分离加固: nohup 只防 SIGHUP, 防不了 AI 工具沙箱在会话边界按进程组收割
# (2026-09-22 实测: WorkBuddy 工具会话里 commit, 后台审核跑到一半被整组 SIGKILL,
# jsonl 冻结无报告无台账)。setsid 新建会话+进程组, 脱离被收割范围; 进程被
# launchd 收养, 终端退出也不受影响。macOS 无 setsid 命令, 用 python3 os.setsid()。
# 兜底纪律: 若仍被杀, mark 不推进 → 下次 commit / pre-push 自动重试, 不会冒充已审。
(
  if command -v setsid >/dev/null 2>&1; then
    setsid "$REVIEWER" "$ROOT" >> /tmp/orca-auto-review.log 2>&1 &
  else
    python3 -c 'import os,sys; os.setsid(); os.execv(sys.argv[1], sys.argv[1:])' \
      "$REVIEWER" "$ROOT" >> /tmp/orca-auto-review.log 2>&1 &
  fi
) 2>/dev/null
exit 0
